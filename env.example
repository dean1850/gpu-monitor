# ─────────────────────────────────────────────────────────────────────────────
#  gpu-monitor — user configuration
#
#  This file is the ONE place you are expected to edit.
#  Copy it to .env before your first `docker compose up`:
#
#      cp .env.example .env
#
#  After editing:  docker compose up -d --build
#                                       ^^^^^^^
#  Without --build, Compose silently reuses the cached image.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
#  1. TIMEZONE
# ═════════════════════════════════════════════════════════════════════════════
#
# Controls the wall-clock times shown in the dashboard header and in
# `docker logs gpu-monitor`. It does NOT affect sampling or the charts —
# those are all relative ("60 seconds ago" ... "0").
#
# Use any IANA timezone name. Full list:
#   https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
#
# To match the Docker host rather than pick one by hand:
#   Linux/macOS:  cat /etc/timezone     (or: timedatectl show -p Timezone --value)
#
# A few from each region, for reference:
#   UTC                 Europe/London       Europe/Berlin       Europe/Madrid
#   America/New_York    America/Chicago     America/Denver      America/Bogota
#   America/Los_Angeles America/Sao_Paulo   Africa/Lagos        Africa/Nairobi
#   Asia/Dubai          Asia/Kolkata        Asia/Shanghai       Asia/Tokyo
#   Australia/Perth     Australia/Sydney    Pacific/Auckland
#
TZ=UTC


# ═════════════════════════════════════════════════════════════════════════════
#  2. GPU VENDOR SWITCHES
# ═════════════════════════════════════════════════════════════════════════════
#
# One switch per vendor. All three can be on at once — a host with an Intel
# iGPU and an NVIDIA card gets a section for each, side by side in the UI.
#
# Each switch is TRI-STATE, not a boolean:
#
#   auto    Enable this backend only if matching hardware is actually found.
#           Absent hardware is silent, not an error. This is the default and
#           the right answer for almost everyone — leave it alone and the
#           dashboard shows exactly the GPUs you have.
#
#   true    Force the backend on. If the hardware or its userspace library
#           is missing, the backend reports an explicit reason via /health
#           and the dashboard tells you why instead of quietly showing
#           nothing. Use this when you EXPECT a card to be there and want to
#           be told loudly if it isn't — the fastest way to debug a
#           passthrough or driver problem.
#
#   false   Never probe. Skips the sysfs walk / library load entirely.
#           Use this to keep logs and /health output clean on a host that
#           will never have that vendor.
#
# ── Intel ────────────────────────────────────────────────────────────────────
# Covers integrated graphics (UHD / Iris Xe) and Arc discrete cards, via the
# i915 or xe driver. Needs /dev/dri passed through — already set in
# docker-compose.yml. This is the fully-tested path.
GPU_ENABLE_INTEL=auto

# ── AMD ──────────────────────────────────────────────────────────────────────
# Covers Radeon discrete and integrated graphics via the amdgpu driver.
# Also uses /dev/dri, so no extra host setup is needed.
GPU_ENABLE_AMD=auto

# ── NVIDIA ───────────────────────────────────────────────────────────────────
# Read through NVML, NOT /dev/dri — NVIDIA's proprietary driver exposes no
# useful DRM sysfs, so passing /dev/dri through does nothing for it.
#
# THIS ONE NEEDS HOST SETUP. Setting it to `true` is not enough on its own:
#
#   1. Install the NVIDIA Container Toolkit for your distro.
#   2. sudo nvidia-ctk runtime configure --runtime=docker
#   3. sudo systemctl restart docker
#   4. Verify:  docker run --rm --gpus all ubuntu nvidia-smi
#   5. Uncomment the `deploy:` block at the bottom of docker-compose.yml.
#
# Leaving this on `auto` without steps 1-5 is harmless — the backend finds no
# libnvidia-ml.so.1, logs one line, and skips itself.
GPU_ENABLE_NVIDIA=auto
