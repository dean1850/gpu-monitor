# gpu-monitor configuration — copy to .env, then: docker compose up -d
# Every setting is explained in QUICKSTART.md. The defaults work as-is.

# Timezone for displayed clock times. Any IANA name, e.g. Europe/London.
TZ=UTC

# Per-vendor switches: auto (detect) | true (force on) | false (never probe).
GPU_ENABLE_INTEL=auto
GPU_ENABLE_AMD=auto
GPU_ENABLE_NVIDIA=auto

# Host port for the dashboard.
GPU_MONITOR_PORT=8088

# NVIDIA hosts only: set these to nvidia and all. Requires the NVIDIA
# Container Toolkit on the host. Leave as-is for Intel/AMD.
DOCKER_RUNTIME=runc
NVIDIA_VISIBLE_DEVICES=void
